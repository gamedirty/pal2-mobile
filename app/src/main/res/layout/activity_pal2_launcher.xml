<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a0d08"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/pal2_title"
            android:textColor="#f3d9b0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pal2_subtitle"
            android:textColor="#b08d5f"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#2b1a10">

            <TextView
                android:id="@+id/TVSystemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="@string/pal2_status_system"
                android:textColor="#c8b49a"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/TVGameDataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="@string/pal2_status_gamedata"
                android:textColor="#c8b49a"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/TVContainerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="@string/pal2_status_container"
                android:textColor="#c8b49a"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/BStartGame"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="#7a1f12"
            android:textColor="#ffe9c8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:enabled="false"
            android:text="@string/pal2_start_game" />

        <Button
            android:id="@+id/BReimportGame"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#b08d5f"
            android:textSize="14sp"
            android:text="@string/pal2_reimport_game" />

        <Button
            android:id="@+id/BAdvanced"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8a6f4d"
            android:textSize="14sp"
            android:text="@string/pal2_advanced_settings" />

        <TextView
            android:id="@+id/TVHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="#7d6547"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
